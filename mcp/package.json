{
  "name": "@juicebox/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Juicebox V6 project intelligence and verifiable transaction planning over MCP",
  "type": "module",
  "exports": {
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "juicebox-mcp": "dist/stdio.js"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/http.ts",
    "dev:stdio": "node --env-file-if-exists=.env --import tsx src/stdio.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/http.js",
    "start:stdio": "node --env-file-if-exists=.env dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run catalog:check",
    "knowledge:sync": "node --import tsx scripts/sync-knowledge.ts",
    "knowledge:check": "node --import tsx scripts/sync-knowledge.ts --check",
    "development:sync": "node --import tsx scripts/sync-development.ts",
    "development:check": "node --import tsx scripts/sync-development.ts --check",
    "catalog:generate": "node --import tsx scripts/generate-catalog.ts",
    "catalog:check": "node --import tsx scripts/generate-catalog.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:live": "node --import tsx scripts/smoke-live.ts",
    "rollout:sync": "node --import tsx scripts/sync-rollout.ts",
    "rollout:check": "node --import tsx scripts/sync-rollout.ts --check"
  },
  "dependencies": {
    "@bananapus/nana-sdk-core": "3.5.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.1.0",
    "multiformats": "13.4.2",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "graphql": "16.11.0",
    "prettier": "3.6.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
