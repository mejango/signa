# Default is dormant: process health only, no runtime factories, migrations, signers or workers.
SIGNA_RUNTIME_ENABLED=false
PORT=3000

# Independent Signa credential origin and public account/API audience.
WALLET_ORIGIN=https://signa.center
REST_PUBLIC_ORIGIN=https://api.signa.center

# Required when activating. Use a fresh Signa database; do not point at Center's production data.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/signa
DWELLIR_API_KEY=
RPC_SITE_LIMIT_PER_MINUTE=20000
# Optional app origins admitted to frame their own sign-ins and payment reviews.
# WALLET_FRAMEABLE_APP_ORIGINS=https://your-app.example

# Protocol-library configuration; Signa does not mount an MCP endpoint.
# Generate a new random secret of at least 32 bytes and keep it stable across Signa replicas/restarts.
MCP_PLAN_SECRET=
# The runtime binds the protocol public origin to REST_PUBLIC_ORIGIN.
MCP_PLAN_TTL_SECONDS=300
MCP_MAX_CONCURRENT_REQUESTS=16
# Each network requires its own authorized complete GraphQL URL.
# MCP_BENDYSTRAW_MAINNET_URL=https://bendystraw.xyz/YOUR_API_KEY/graphql
# MCP_BENDYSTRAW_TESTNET_URL=https://testnet.bendystraw.xyz/YOUR_API_KEY/graphql

# Base creation: configure all four together with a newly funded Signa sender and pool.
# Review the allocation and sender's initial nonce; do not reuse Center's active signer.
# WALLET_CREATION_SIGNER_KEY=
# WALLET_CREATION_POOL_ID=
# WALLET_CREATION_ALLOCATION_WEI=
# WALLET_CREATION_INITIAL_NONCE=
# Recovery and device addition: configure all three with a separate funded Signa sender.
# WALLET_RECOVERY_SIGNER_KEY=
# WALLET_RECOVERY_MAX_OPERATIONS=
# WALLET_RECOVERY_MAX_COST_WEI=
# Optional additional-network funding. Use another independent sender, not either key above.
# WALLET_NETWORKS_PAYER_KEY=

# Configure reviewed ERC-4337 providers, gas ceilings and sponsor policies before enabling execution.
# REST_ERC4337_CONFIG=
# Optional server-authorized app sponsorship; secrets stay on the backend.
# REST_ERC4337_SPONSOR_ROUTES=
