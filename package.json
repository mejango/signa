{
  "name": "signa",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node dist/src/index.js",
    "build:mcp": "npm --prefix mcp run build",
    "build": "node scripts/rest/clean-build.mjs && npm run build:mcp && npm run build:web && tsc -p tsconfig.build.json && npm run build:client && node scripts/rest/copy-assets.mjs",
    "test": "vitest run",
    "load:test": "node scripts/load-test.mjs",
    "wallet:pressure": "node --import tsx scripts/rest/wallet-pressure.ts",
    "typecheck": "npm run build:mcp && tsc --noEmit",
    "check": "node scripts/rest/check-required-tests.mjs",
    "check:preflight": "node scripts/rest/check-required-tests.mjs --preflight",
    "check:execution": "node scripts/rest/check-execution.mjs",
    "check:wallet-compatibility": "node src/rest/smartAccounts/stack/passkey/verify.mjs",
    "wallet:device-probe": "node --import tsx scripts/rest/wallet-device-probe.ts",
    "wallet:client-pilot": "vitest run --config acceptance/shared-wallet/vitest.config.ts",
    "wallet:production-stack": "node --import tsx scripts/rest/wallet-production-stack.ts",
    "wallet:dependency-bundle": "node --import tsx scripts/rest/wallet-dependency-bundle.ts",
    "wallet:dependency-reconcile": "node --import tsx scripts/rest/wallet-dependency-reconcile.ts",
    "wallet:dependency-quote": "node --import tsx scripts/rest/wallet-dependency-quote.ts",
    "wallet:dependency-funding": "node --import tsx scripts/rest/wallet-dependency-funding.ts",
    "verify:execution-artifacts": "node src/rest/smartAccounts/stack/verify-artifacts.mjs",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts",
    "build:web": "node scripts/rest/build-web.mjs",
    "rest": "node scripts/rest/center.mjs",
    "build:client": "node scripts/rest/build-client.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@juicebox/mcp": "file:./mcp",
    "@scure/bip39": "1.6.0",
    "busboy": "^1.6.0",
    "cbor2": "2.3.0",
    "hono": "^4.13.8",
    "marked": "18.0.12",
    "multiformats": "^13.4.2",
    "pg": "^8.16.3",
    "undici": "^6.28.1",
    "viem": "^2.37.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "qrcode": "^1.5.4",
    "rollup": "4.63.2",
    "rollup-plugin-dts": "6.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  }
}
